# Variables que lee docker-compose. `make setup` copia este archivo a .env
# y genera valores aleatorios para APP_KEY, WEBHOOK_SECRET y DEMO_USER_PASSWORD.
# Nunca subas el .env real al repositorio.

APP_KEY=
APP_URL=http://localhost:8090
WEB_PORT=8090

# Secreto compartido con el proveedor que llama al webhook (HMAC-SHA256).
WEBHOOK_SECRET=

# Usuario del panel (se crea al levantar la API).
DEMO_USER_EMAIL=admin@demo.cl
DEMO_USER_PASSWORD=

# En local se sirve por HTTP; en producción (HTTPS) debe ir en true.
SESSION_SECURE_COOKIE=false
